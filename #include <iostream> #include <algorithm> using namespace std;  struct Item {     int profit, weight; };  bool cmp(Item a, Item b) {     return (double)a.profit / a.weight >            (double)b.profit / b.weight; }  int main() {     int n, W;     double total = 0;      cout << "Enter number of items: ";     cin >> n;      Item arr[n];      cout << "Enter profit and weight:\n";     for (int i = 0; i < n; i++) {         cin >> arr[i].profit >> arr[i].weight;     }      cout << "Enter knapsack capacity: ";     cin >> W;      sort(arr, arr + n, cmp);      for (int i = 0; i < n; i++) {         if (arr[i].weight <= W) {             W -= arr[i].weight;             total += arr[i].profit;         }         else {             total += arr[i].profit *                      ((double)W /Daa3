#include <iostream>
#include <algorithm>
using namespace std;

struct Item {
    int profit, weight;
};

bool cmp(Item a, Item b) {
    return (double)a.profit / a.weight >
           (double)b.profit / b.weight;
}

int main() {
    int n, W;
    double total = 0;

    cout << "Enter number of items: ";
    cin >> n;

    Item arr[n];

    cout << "Enter profit and weight:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i].profit >> arr[i].weight;
    }

    cout << "Enter knapsack capacity: ";
    cin >> W;

    sort(arr, arr + n, cmp);

    for (int i = 0; i < n; i++) {
        if (arr[i].weight <= W) {
            W -= arr[i].weight;
            total += arr[i].profit;
        }
        else {
            total += arr[i].profit *
                     ((double)W / arr[i].weight);
            break;
        }
    }

    cout << "Maximum Profit = " << total;

    return 0;
}
